{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch",
        "padding": {
            "top": 1,
            "right": 6,
            "left": 2
        }
    },
    "display": {
        "separator": " 󰁔 ",
        "color": {
            "separator": "blue"
        },
        "disableLinewrap": true
    },
    "modules": [
        "break",
        {
            "type": "title",
            "color": {
                "user": "magenta",
                "at": "cyan",
                "host": "blue"
            }
        },
        "break",
        {
            "type": "os",
            "key": "   OS      ",
            "keyColor": "blue"
        },
        {
            "type": "kernel",
            "key": "   Kernel  ",
            "keyColor": "cyan"
        },
        {
            "type": "uptime",
            "key": " 󰅐  Uptime  ",
            "keyColor": "green"
        },
        {
            "type": "packages",
            "key": " 󰏖  Packages",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": "   Shell   ",
            "keyColor": "magenta"
        },
        {
            "type": "display",
            "key": " 󰍹  Display ",
            "keyColor": "red"
        },
        {
            "type": "wm",
            "key": "   WM      ",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "   Terminal",
            "keyColor": "cyan"
        },
        "break",
        {
            "type": "cpu",
            "key": "   CPU     ",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": " 󰢮  GPU     ",
            "keyColor": "yellow"
        },
        {
            "type": "memory",
            "key": "   Memory  ",
            "keyColor": "magenta"
        },
        {
            "type": "swap",
            "key": " 󰓡  Swap    ",
            "keyColor": "red"
        },
        {
            "type": "disk",
            "key": " 󰋊  Disk    ",
            "keyColor": "blue"
        },
        {
            "type": "battery",
            "key": " 󰁹  Battery ",
            "keyColor": "green"
        },
        {
            "type": "localip",
            "key": " 󰩟  Local IP",
            "keyColor": "cyan"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        },
        "break"
    ]
}
